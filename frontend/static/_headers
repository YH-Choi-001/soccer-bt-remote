# This is a Cloudflare HTTP Header configuration file.

/*
    X-Content-Type-Options: nosniff
    Referrer-Policy: strict-origin-when-cross-origin
    Strict-Transport-Security: max-age=31536000; includeSubDomains
    Content-Security-Policy: default-src 'self'; style-src 'unsafe-inline'; font-src 'self' https://fonts.googleapis.com
    X-Frame-Options: SAMEORIGIN
    Permissions-Policy: accelerometer=(), ambient-light-sensor=(), bluetooth=(self), camera=(), geolocation=(), gyroscope=(self), magnetometer=(self), microphone=(), payment=(), screen-wake-lock=(self), serial=(self)
